{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facets.arkavo.dev/schemas/v1/event.schema.json",
  "title": "FACETS event record or journal entry",
  "description": "An event record (pending or final) with pinned definitions, dice, arithmetic, choices and applied state operations, or a journal entry replayed from recorded operations. Replay never draws dice.",
  "oneOf": [
    {"$ref": "#/$defs/record"},
    {"$ref": "#/$defs/journal_entry"}
  ],
  "$defs": {
    "revision": {"type": "integer", "minimum": 0},
    "path": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer"]}},
    "state_op": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "before", "after"], "properties": {"op": {"const": "set"}, "path": {"$ref": "#/$defs/path"}, "before": true, "after": true}},
        {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"enum": ["append", "remove"]}, "path": {"$ref": "#/$defs/path"}, "value": true}},
        {"type": "object", "additionalProperties": false, "required": ["op", "actor"], "properties": {"op": {"const": "add_actor"}, "actor": {"type": "object", "required": ["actor_id"]}}},
        {"type": "object", "required": ["op", "kind"], "properties": {"op": {"const": "note"}, "kind": {"type": "string"}}}
      ]
    },
    "state_ops": {"type": "array", "items": {"$ref": "#/$defs/state_op"}},
    "journal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sequence", "kind", "event_id", "before_revision", "after_revision", "ops", "data"],
      "properties": {
        "format": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"},
        "event_id": {"type": "string", "pattern": "^evt-\\d{6,}$"},
        "before_revision": {"$ref": "#/$defs/revision"},
        "after_revision": {"$ref": "#/$defs/revision"},
        "ops": {"$ref": "#/$defs/state_ops"},
        "data": {"type": "object"}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["band", "target", "total", "margin"],
      "properties": {
        "dice": {"$ref": "common.schema.json#/$defs/dice"},
        "facet": {"type": "integer"},
        "skill": {"type": "integer"},
        "modifier_raw": {"type": "integer"},
        "modifier_applied": {"type": "integer", "minimum": -3, "maximum": 3},
        "push_bonus": {"enum": [0, 1]},
        "resolve_bonus": {"enum": [0, 2]},
        "total": {"type": "integer"},
        "target": {"type": "integer"},
        "margin": {"type": "integer"},
        "band": {"$ref": "common.schema.json#/$defs/band"},
        "allows_costly_success": {"type": "boolean"},
        "routine": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "anyOf": [
        {"maxProperties": 0},
        {
          "required": ["event_id", "decision_id", "kind", "options"],
          "properties": {
            "event_id": {"type": "string"},
            "decision_id": {"type": "string"},
            "kind": {"enum": ["resolve", "cost", "benefit", "identity"]},
            "prompt": {"type": "string"},
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}
            },
            "frozen_options": {"type": "object"}
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "kind", "option_id"],
      "properties": {
        "decision_id": {"type": "string"},
        "kind": {"enum": ["resolve", "cost", "benefit", "identity"]},
        "option_id": {"type": "string"},
        "auto": {"type": "boolean"},
        "abandoned": {"type": "boolean"}
      }
    },
    "record": {
      "type": "object",
      "required": ["event_id", "kind", "status", "actor_id", "before_revision", "after_revision"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt-\\d{6,}$"},
        "kind": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"},
        "status": {"enum": ["pending", "final"]},
        "actor_id": {"type": "string"},
        "scene_id": {"type": "string"},
        "before_revision": {"$ref": "#/$defs/revision"},
        "after_revision": {"$ref": "#/$defs/revision"},
        "visibility": {"type": "string"},
        "action": {"$ref": "action.schema.json"},
        "action_id": {"type": "string"},
        "action_version": {"type": "integer", "minimum": 1},
        "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approach_id": {"type": "string"},
        "request": {"$ref": "request.schema.json"},
        "routine": {"type": "boolean"},
        "push": {"type": "boolean"},
        "dice": {"$ref": "common.schema.json#/$defs/dice"},
        "base": {"$ref": "#/$defs/evaluation"},
        "evaluation": {"$ref": "#/$defs/evaluation"},
        "final_band": {"$ref": "common.schema.json#/$defs/band"},
        "decision": {"$ref": "#/$defs/decision"},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
        "commit_ops": {"$ref": "#/$defs/state_ops"},
        "finalize_ops": {"$ref": "#/$defs/state_ops"},
        "ops": {"$ref": "#/$defs/state_ops"},
        "resource_deltas": {"type": "object", "additionalProperties": {"type": "integer"}},
        "effect_labels": {"type": "array", "items": {"type": "string"}},
        "modifier_lines": {"type": "array", "items": {"type": "object"}},
        "accepted": {"type": "boolean"},
        "amount": {"type": "integer", "minimum": 0, "maximum": 1},
        "award_key": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "check"}}},
          "then": {"required": ["action", "request", "dice", "base", "push", "routine", "choices", "decision"]}
        },
        {
          "if": {"properties": {"kind": {"const": "check"}, "status": {"const": "final"}}},
          "then": {"required": ["final_band", "finalize_ops"]}
        },
        {
          "if": {"properties": {"status": {"const": "pending"}}},
          "then": {"required": ["decision"], "properties": {"decision": {"minProperties": 1}}}
        },
        {
          "if": {"properties": {"kind": {"const": "identity"}, "status": {"const": "final"}}},
          "then": {"required": ["trigger_id", "accepted", "disadvantage", "award_key", "amount"]}
        }
      ]
    }
  }
}

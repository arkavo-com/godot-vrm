[resource]
script = ExtResource("5_1eh3u")
id = "nm.ask_guard"
display_name = "Ask Rook to open the side gate"
description = "Talk the guard into letting you through the side gate before curfew."
objective_id = "nm.objective.ask_guard"
tags = Array[String](["social", "route"])
approaches = Array[ExtResource("1_wnchq")]([SubResource("Resource_do01c")])
requirements = Array[ExtResource("3_ylvs5")]([SubResource("Resource_ws43a"), SubResource("Resource_l3x3i"), SubResource("Resource_06ukh"), SubResource("Resource_n5q3r")])
relationship = {
"dimension": "trust",
"other_id": "npc.rook"
}
clock_cost = 1
allows_costly_success = true
costly_options = Array[ExtResource("2_jpmdq")]([SubResource("Resource_plode")])
success_effects = Array[ExtResource("3_ylvs5")]([SubResource("Resource_61umf"), SubResource("Resource_w6m6o")])
failure_effects = Array[ExtResource("3_ylvs5")]([SubResource("Resource_bh8vu"), SubResource("Resource_0ckrc")])
strong_benefits = Array[ExtResource("4_gihwr")]([SubResource("Resource_sau7v"), SubResource("Resource_i6noa")])
default_benefit_id = "route"
lesser_concessions = Array[ExtResource("4_gihwr")]([SubResource("Resource_do1mn")])
success_stakes = "The side gate opens and you are inside."
failure_stakes = "Rook raises the alarm and the patrol is called."

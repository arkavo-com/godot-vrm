[resource]
script = ExtResource("5_b6nod")
id = "nm.follow_lead"
display_name = "Follow the passenger's lead"
description = "Tamsin saw a courier dragged toward the canal. Find where."
objective_id = "nm.objective.follow_lead"
approaches = Array[ExtResource("1_kx4ls")]([SubResource("Resource_tk8cg"), SubResource("Resource_7lasx")])
requirements = Array[ExtResource("3_hbaap")]([SubResource("Resource_ybvx8"), SubResource("Resource_v014b")])
target = 13
success_effects = Array[ExtResource("3_hbaap")]([SubResource("Resource_igrfk"), SubResource("Resource_i77bk")])
failure_effects = Array[ExtResource("3_hbaap")]([SubResource("Resource_0qt0e")])
success_stakes = "You find where the courier was taken."
failure_stakes = "The trail goes cold for an hour."
alternate_evidence_sources = Array[String](["evidence.bag_seal", "evidence.cctv"])
revealable_facts = Array[String](["fact.canal_footprints"])

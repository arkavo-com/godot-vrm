[resource]
script = ExtResource("5_e2tbx")
id = "nm.bypass_controller"
display_name = "Bypass the service door controller"
description = "Splice into the service door's controller and open it."
objective_id = "nm.objective.bypass_controller"
tags = Array[String](["technical", "route"])
approaches = Array[ExtResource("1_0ace4")]([SubResource("Resource_k1ayv")])
requirements = Array[ExtResource("3_pmbsr")]([SubResource("Resource_ws43a"), SubResource("Resource_l3x3i"), SubResource("Resource_gcy7u"), SubResource("Resource_eow6v")])
required_tools = Array[String](["tool.signal_kit"])
consumable_substitutes = Array[String](["item.scrap_wire"])
target = 13
clock_cost = 1
allows_costly_success = true
costly_options = Array[ExtResource("2_8jqdp")]([SubResource("Resource_vlrpt")])
success_effects = Array[ExtResource("3_pmbsr")]([SubResource("Resource_qkllp"), SubResource("Resource_4xt4n")])
failure_effects = Array[ExtResource("3_pmbsr")]([SubResource("Resource_r067d"), SubResource("Resource_de26x")])
strong_benefits = Array[ExtResource("4_e8s6x")]([SubResource("Resource_kpyfu"), SubResource("Resource_ep4vg")])
default_benefit_id = "silent"
success_stakes = "The service door opens."
failure_stakes = "The patrol advances and the controller locks down."
